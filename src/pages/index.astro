---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
const posts = await getPosts();
---

<Base>
  <h1 class="sr-only">Posts</h1>
  <PostList posts={posts} />
</Base>
<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
