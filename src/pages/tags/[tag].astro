---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, getTags, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const tags = getTags(await getPosts());
  return [...tags.entries()].map(([tag, t]) => ({ params: { tag }, props: t }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base title={`#${name}`} description={`Posts tagged ${name}`}>
  <h1>#{name}</h1>
  <PostList posts={posts} label={`TAG-${name}`} />
</Base>
