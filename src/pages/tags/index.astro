---
import Base from "../../layouts/Base.astro";
import { getPosts, getTags } from "../../lib/posts";
const tags = [...getTags(await getPosts()).entries()].sort((a, b) => a[1].name.localeCompare(b[1].name));
---

<Base title="Tags">
  <h1>Tags</h1>
  <ul class="list">
    {tags.map(([slug, t]) => (
      <li>
        <a class="tag" href={`/tags/${slug}/`}>
          {t.name} <span aria-label={`${t.posts.length} posts`}>· {t.posts.length}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
<style>
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }
</style>
